# "mock" uses synthetic EGX data (no account needed).
# "live" uses the official Younit SDK (pip install the younit-python source first).
YOUNIT_MODE=mock

# Live credentials, read by the Younit SDK itself. Never commit a real .env file.
TRADING_ID=
API_KEY=

# Live mode runs in Younit's simulation (paper) environment unless this is true.
YOUNIT_REAL_MONEY=false

# Stocks shown in the dashboard list in live mode.
YOUNIT_WATCHLIST=COMI,HRHO,TMGH,EAST,SWDY,FWRY,ETEL,ABUK

# Safety switches
# Order placement stays off until you flip this. Previews still work.
YOUNIT_TRADING_ENABLED=false
# Hard cap per order, in EGP. Market orders are priced at the last price, so they are capped too.
YOUNIT_MAX_ORDER_EGP=5000
# Seconds a preview token stays valid before it must be re-previewed.
YOUNIT_CONFIRM_TTL_SECONDS=120
